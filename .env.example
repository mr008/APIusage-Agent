# Anthropic API key — https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Firecrawl API key (web search + page scraping) — https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# Optional: override the model (default: claude-opus-5).
# Rough cost per run: claude-opus-5 ~$1-2.50, claude-sonnet-5 ~$0.35,
# claude-haiku-4-5 ~$0.15-0.25 (cheapest; noticeably weaker research).
# AGENT_MODEL=claude-haiku-4-5
